---
import type { Crumb } from '../types';

interface Props {
  items: Crumb[];
  tone?: 'light' | 'dark';
  class?: string;
}

const { items, tone = 'light', class: className = '' } = Astro.props;
const trail: Crumb[] = [{ label: 'Accueil', href: '/' }, ...items];
---

<nav aria-label="Fil d'Ariane" class={className}>
  <ol
    class:list={[
      'flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px]',
      tone === 'dark' ? 'text-white/60' : 'text-bark-600',
    ]}
  >
    {
      trail.map((crumb, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && <span aria-hidden="true">/</span>}
          {crumb.href && index < trail.length - 1 ? (
            <a
              href={crumb.href}
              class:list={[
                'transition-fast transition-colors',
                tone === 'dark' ? 'hover:text-white' : 'hover:text-sap-700',
              ]}
            >
              {crumb.label}
            </a>
          ) : (
            <span
              aria-current="page"
              class:list={[tone === 'dark' ? 'text-white/80' : 'text-bark-600']}
            >
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
