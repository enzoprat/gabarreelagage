---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import { SITE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique, ex. /services/elagage */
  path: string;
  noindex?: boolean;
  ogImage?: string;
  /** Objets JSON-LD deja construits */
  schemas?: unknown[];
}

const {
  title,
  description,
  path,
  noindex = false,
  ogImage = '/og-default.png',
  schemas = [],
} = Astro.props;

const canonical = new URL(path, SITE_URL).href.replace(/\/$/, '') || SITE_URL;
const ogUrl = new URL(ogImage, SITE_URL).href;

/** Vide en production, `/gabarreelagage` sur la preview GitHub Pages. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/** Evite toute fermeture prematuree du script JSON-LD. */
const serialize = (data: unknown) =>
  JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <meta name="theme-color" content="#0D1210" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gabarre Élagage" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Gabarre Élagage, élagueur à Montauban"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={serialize(schema)} />
      ))
    }
  </head>

  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-[8px] focus:bg-bark-950 focus:px-4 focus:py-3 focus:text-white"
    >
      Aller au contenu principal
    </a>

    <Header />

    <main id="contenu">
      <slot />
    </main>

    <Footer />
    <StickyCallBar />
  </body>
</html>
